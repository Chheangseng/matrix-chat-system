# Matrix Synapse Server Configuration
SYNAPSE_SERVER_NAME=localhost
SYNAPSE_REPORT_STATS=no

# Database Configuration
POSTGRES_USER=synapse
POSTGRES_PASSWORD=synapse_secret_password
POSTGRES_DB=synapse

# Ports
SYNAPSE_HTTP_PORT=8008

# Default Synapse Admin Account
SYNAPSE_ADMIN_USER=admin
SYNAPSE_ADMIN_PASSWORD=admin_password_123
SYNAPSE_ADMIN_TOKEN=

# Go Gin Gateway Configuration
APP_PORT=8080
APP_ENV=development
SYNAPSE_TARGET_URL=http://localhost:8008
ALLOWED_ORIGINS=*

# HTP OIDC Single Sign-On Configuration
HTP_OIDC_ISSUER=http://localhost:5054
OIDC_CLIENT_ID=your_oidc_client_id
OIDC_CLIENT_SECRET=your_oidc_client_secret
OIDC_REDIRECT_URI=http://localhost:8080/api-server/auth/callback
